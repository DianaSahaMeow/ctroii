# Параметры подключения к PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=defect_tracker
DB_USERNAME=postgres
DB_PASSWORD=postgres_secure_password_2026

# Прямой JDBC URL (если используется Supabase, Neon или Render)
# DB_URL=jdbc:postgresql://ep-example-123.eu-central-1.aws.neon.tech/defect_tracker?sslmode=require

# Порт приложения
PORT=8080

# Каталог локального хранения фотографий дефектов
UPLOAD_DIR=./uploads/defects

# Тип хранилища: 'local' или 's3'
STORAGE_TYPE=local
